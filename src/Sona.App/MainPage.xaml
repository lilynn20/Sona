<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sona.App.MainPage"
             Title="Sona">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="#1E293B" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sona" FontSize="36" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Local-first music library manager" FontSize="16" TextColor="#C7D2FE" />
                </VerticalStackLayout>
            </Border>

            <Frame Padding="18" BorderColor="#334155" CornerRadius="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Library status" FontAttributes="Bold" FontSize="18" />
                    <Label x:Name="LibraryStatusLabel"
                           Text="No scan has run yet."
                           FontSize="16" />
                    <Button Text="Scan library"
                            Clicked="OnScanClicked"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="12">
                <Frame Grid.Column="0" Padding="14" BorderColor="#334155" CornerRadius="12">
                    <VerticalStackLayout>
                        <Label Text="Tracks" FontAttributes="Bold" />
                        <Label Text="0" FontSize="28" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="14" BorderColor="#334155" CornerRadius="12">
                    <VerticalStackLayout>
                        <Label Text="Artists" FontAttributes="Bold" />
                        <Label Text="0" FontSize="28" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
