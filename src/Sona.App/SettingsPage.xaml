<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sona.App.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Settings" FontSize="32" FontAttributes="Bold" />

            <Frame Padding="18" BorderColor="#334155" CornerRadius="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Library folder" FontAttributes="Bold" FontSize="18" />
                    <Entry x:Name="LibraryFolderEntry"
                           Placeholder="C:\\Music or a folder path"
                           WidthRequest="300" />
                    <Button x:Name="SaveFolderButton"
                            Text="Save folder"
                            Clicked="OnSaveFolderClicked"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="18" BorderColor="#334155" CornerRadius="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="App behavior" FontAttributes="Bold" FontSize="18" />
                    <CheckBox x:Name="AutoScanCheckBox" IsChecked="true" />
                    <Label Text="Start scanning automatically when the app opens" FontSize="14" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
